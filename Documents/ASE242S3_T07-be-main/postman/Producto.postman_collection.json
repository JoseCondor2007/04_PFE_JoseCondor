            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_producto\": \"P006\",\n  \"nombre\": \"Causa Rellena\",\n  \"descripcion\": \"Causa de papa amarilla rellena de atún y palta\",\n  \"precio\": 25.00,\n  \"categoria\": \"ENTRADA\",\n  \"estado\": \"ACTIVO\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/productos",
              "protocol": "http",
              "host": [
