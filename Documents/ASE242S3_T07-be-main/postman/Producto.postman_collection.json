            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"codigo_producto\": \"P001\",\n  \"nombre\": \"Ceviche Tradicional\",\n  \"descripcion\": \"Pescado del día marinado en limón con un toque de ají limo\",\n  \"precio\": 30.00,\n  \"categoria\": \"ENTRADA\",\n  \"estado\": \"ACTIVO\"\n}"
